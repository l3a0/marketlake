# Written by `python -m lake.control_plane render --init systemd`. Change the renderer,
# not this file: the install entry point renders afresh on every run.

[Unit]
Description=com.marketlake.sunday
RequiresMountsFor=/srv/lake

[Service]
Type=oneshot
User=someone
WorkingDirectory=/home/someone/marketlake
Environment=HOME=/home/someone
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/someone/marketlake/.venv/bin/python -m lake.control_plane sunday --token /home/someone/.config/marketlake/token.json
