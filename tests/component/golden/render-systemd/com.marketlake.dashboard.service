# Written by `python -m lake.control_plane render --init systemd`. Change the renderer,
# not this file: the install entry point renders afresh on every run.

[Unit]
Description=com.marketlake.dashboard
StartLimitIntervalSec=0
RequiresMountsFor=/srv/lake

[Service]
Type=exec
User=someone
WorkingDirectory=/home/someone/marketlake
Environment=HOME=/home/someone
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/someone/marketlake/.venv/bin/python -m lake.dashboard
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
