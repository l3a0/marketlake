# Written by `python -m lake.control_plane render --init systemd`. Change the renderer,
# not this file: the install entry point renders afresh on every run.

[Unit]
Description=com.marketlake.eod-sweep

[Timer]
OnCalendar=Mon..Fri 18:30:00 America/New_York
AccuracySec=1s
Persistent=true

[Install]
WantedBy=timers.target
