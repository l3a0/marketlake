<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/someone</string>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
	</dict>
	<key>GroupName</key>
	<string>staff</string>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.marketlake.dashboard</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/py/bin/python</string>
		<string>-m</string>
		<string>lake.dashboard</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/someone/Library/Logs/marketlake/com.marketlake.dashboard.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/someone/Library/Logs/marketlake/com.marketlake.dashboard.out.log</string>
	<key>UserName</key>
	<string>someone</string>
	<key>WorkingDirectory</key>
	<string>/Users/someone/marketlake</string>
</dict>
</plist>
